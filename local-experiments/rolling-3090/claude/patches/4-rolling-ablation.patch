+def assignment_fingerprints(result, evaluation_root, schedule, cache):
+    """Per cell, hashes of the exact labels and of the grouping up to a die exchange.
+
+    Equal label hashes on every cell mean an identical partition; equal grouping hashes with
+    different label hashes mean the same grouping with the dies exchanged. Names never leave here.
+    """
+    prints = {}
+    for cell in schedule:
+        key = _cell_key(cell)
+        snapshot = _assignment_snapshot(result, evaluation_root, key, cache)
+        if snapshot is None:
+            continue
+        names, labels, count = snapshot
+        exchanged = labels ^ int.from_bytes(b"\x01" * count, "little")
+        prints[key] = {"labels": sha256(names + labels.to_bytes(count, "little")).hexdigest()[:16],
+                       "grouping": sha256(names + min(labels, exchanged).to_bytes(count, "little")).hexdigest()[:16]}
+    return prints
+
