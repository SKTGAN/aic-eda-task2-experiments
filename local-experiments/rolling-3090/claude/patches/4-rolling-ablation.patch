+                                        "from": better["id"], "versus": worse["id"],
+                                        "context": {held: better["factors"][held]}, "case": row["case"],
+                                        "mean_delta": round(signed["mean_delta"], 4),
+                                        "credible_seeds": signed["credible_improved"], "seeds": row["seeds"],
+                                        "evidence": "%s-%s" % (better["id"], worse["id"])})
